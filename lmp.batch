#!/bin/bash
#
#SBATCH --job-name=Ag
#SBATCH --container=el9hw
#SBATCH --partition=cm3atou_el9
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=32
#SBATCH --output=Ag.out
#SBATCH --error=Ag.err
#SBATCH --mail-user=youremailaddress@yourinstitution.edu
#SBATCH --mail-type=ALL
#
#################################################

# Defining the executable and scratch directory

#cd ${SLURM_SUBMIT_DIR}

module load intel/2023b

# execute lammps
echo "begin lammps"
echo "the job is ${SLURM_JOB_ID}"

rm -f dump.* shear.*

mpirun ~/software/lammps-mbvo/mylammps/src/lmp_mpi -in lmp.in

echo "lammps out"

